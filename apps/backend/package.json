{
  "name": "@realtime-markers/backend",
  "module": "index.ts",
  "type": "module",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "latest",
    "@types/ngeohash": "^0.6.8",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "scripts": {
    "typeorm": "bunx tsx ./node_modules/typeorm/cli.js",
    "migration:create": "bunx tsx ./node_modules/typeorm/cli.js migration:create",
    "migration:generate": "bunx tsx ./node_modules/typeorm/cli.js migration:generate -d ./data-source.ts",
    "migration:run": "bunx tsx ./node_modules/typeorm/cli.js migration:run -d ./data-source.ts",
    "migration:revert": "bunx tsx ./node_modules/typeorm/cli.js migration:revert -d ./data-source.ts",
    "check-db": "bun run scripts/check-database-setup.ts",
    "seed": "bun run scripts/seed.ts",
    "test": "bun test",
    "test:email": "bun run scripts/test-email.ts",
    "test:push": "bun run scripts/test-push-notifications.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.995.0",
    "@aws-sdk/s3-request-presigner": "^3.995.0",
    "@realtime-markers/shared": "workspace:*",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.6.1",
    "expo-server-sdk": "^3.15.0",
    "geo-tz": "^8.1.5",
    "hono": "^4.12.0",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.3",
    "ngeohash": "^0.6.3",
    "openai": "^6.25.0",
    "pg": "^8.18.0",
    "pgvector": "^0.2.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.8.0",
    "typeorm": "^0.3.28",
    "zod": "^3.25.76"
  }
}
